.{
    .name = .relic_native,
    .version = "2.0.0-rc.2",
    .fingerprint = 0x538fb26d0ce37fa8,
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // zio with Executor.tick and its thread bindings, io_uring_single_issuer,
        // ip6_only and SO_EXCLUSIVEADDRUSE on a Windows listener, until they are
        // upstream.
        .zio = .{
            .url = "git+https://github.com/nielsenko/zio#054581978e9222662a31a8837aa7f3a24c66720b",
            .hash = "zio-0.19.0-xHbVVNG0MAB19GQbu8OMQ97BM9EA3LHjQHLX1Jj3uLG1",
        },
        // ianic's tls.zig with the server picking the cipher suite in its own
        // order, a refused client certificate answered with its alert, RSA
        // signing through the CRT form of the key and a shallower handshake
        // stack, until all are upstream.
        .tls = .{
            .url = "git+https://github.com/nielsenko/tls.zig#b82c88ae952af27b6c743dc59bc5ad99425a95d6",
            .hash = "tls-0.1.0-ER2e0qPoBgDgveMWLM-7CrYIYltv57Rqm92zy-XGgYcL",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
