.{
    .name = .relic_native,
    .version = "2.0.0-rc.2",
    .fingerprint = 0x538fb26d0ce37fa8,
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // zio with the Executor.tick patch, io_uring_single_issuer, ip6_only and
        // SO_EXCLUSIVEADDRUSE on a Windows listener, until they are upstream.
        .zio = .{
            .url = "git+https://github.com/nielsenko/zio#f703d2fbb5e43596c25411cb8cbef6041096be8b",
            .hash = "zio-0.19.0-xHbVVOi6LgBziuPlG5JwbETAEsNVOBMGkOLeJ3OGnZ5D",
        },
        // ianic's tls.zig with the server picking the cipher suite in its own
        // order, a refused client certificate answered with its alert and
        // RSA signing through the CRT form of the key, until all are upstream.
        .tls = .{
            .url = "git+https://github.com/nielsenko/tls.zig#0f3b2cb7af6a37d33a89a97a59ed5cb9396250ab",
            .hash = "tls-0.1.0-ER2e0nHYBgCzek0BUvu1Q6RCkEk07lRWmjM-5pxgugit",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
